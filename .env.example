# 이 파일을 복사해 .env 로 저장한 뒤 실제 키 값을 입력하세요.
#   cp .env.example .env
#
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 이미 포함되어 있습니다).

# OpenAI API 키 (필수) - https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Kakao Local API REST 키 (선택, 없으면 맛집 섹션이 '데이터 없음'으로 처리됨)
# 발급: https://developers.kakao.com > 내 애플리케이션 > REST API 키
KAKAO_API_KEY="YOUR_KAKAO_REST_API_KEY"
